[Unit]
Description=Harvey ambient visuals (full-screen kiosk)
Wants=harvey-relay.service
After=harvey-relay.service
# Keep retrying forever, however often Chromium crashes.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/harvey/ambient-device-visuals/pi/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
